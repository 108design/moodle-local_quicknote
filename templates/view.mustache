    View template for local_quicknote.

    Example context (json):
    {
        "filterbycourse": "Filter by course",
        "allcourses": "All courses",
        "nonotesfound": "No notes found.",
        "searchnotes": "Search notes...",
        "search": "Search",
        "exportpdf": "Export to PDF",
        "hasnotestosearch": true,
        "hasnotes": true,
        "coursefilter": 0,
        "searchterm": "",
        "config": {
            "wwwroot": "http://localhost/moodle"
        },
        "courses": [
            {
                "id": 1,
                "fullname": "Digital Systems",
                "selected": false
            }
        ],
        "notes": [
            {
                "coursefullname": "Digital Systems",
                "content": "Remember to review logic gates for the exam.",
                "timeupdated": "May 28, 2026, 14:03",
                "quote": "The NAND gate is universal.",
                "quoteurl": "http://localhost/moodle/mod/page/view.php?id=2"
            }
        ]
    }
}}

<div class="local-quicknote-center">
    <div class="local-quicknote-center__controls mb-4">
        <form method="GET" action="{{config.wwwroot}}/local/quicknote/view.php" class="local-quicknote-center__filters">
            <div class="local-quicknote-center__filter-row">
                <div class="local-quicknote-center__filter-group">
                    <label for="coursefilter" class="font-weight-bold mb-0">{{filterbycourse}}</label>
                    <select name="coursefilter" id="coursefilter" class="custom-select form-select">
                        <option value="0">{{allcourses}}</option>
                        {{#courses}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{fullname}}</option>
                        {{/courses}}
                    </select>
                </div>
                {{#hastags}}
                <div class="local-quicknote-center__filter-group">
                    <label for="tagfilter" class="font-weight-bold mb-0">{{filterbytag}}</label>
                    <select name="tagfilter" id="tagfilter" class="custom-select form-select">
                        <option value="0">{{alltags}}</option>
                        {{#usertags}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/usertags}}
                    </select>
                </div>
                {{/hastags}}
                {{#hasnotestosearch}}
                <div class="local-quicknote-center__search-group">
                    <div class="input-group">
                        <label class="sr-only" for="searchterm">{{searchnotes}}</label>
                        <div class="local-quicknote-center__search-wrapper">
                            <input type="text" name="searchterm" id="searchterm" class="form-control local-quicknote-center__search-input" placeholder="{{searchnotes}}" value="{{searchterm}}">
                            <button type="button" class="btn btn-sm btn-link local-quicknote-center__search-clear" id="clearsearch" title="{{#str}} search:clear, local_quicknote {{/str}}" aria-label="{{#str}} search:clear, local_quicknote {{/str}}" {{^searchterm}}hidden{{/searchterm}}>
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary local-quicknote-center__search-submit" type="submit">
                                <i class="fa fa-search mr-1" aria-hidden="true"></i>{{search}}
                            </button>
                        </div>
                    </div>
                </div>
                {{/hasnotestosearch}}
            </div>
        </form>

        <div class="local-quicknote-center__exports" data-region="quicknote-exports" {{^hasnotes}}hidden{{/hasnotes}}>
            {{#hasnotes}}
            <a href="{{mdurl}}" class="local-quicknote-center__export" title="{{exportmd}}" aria-label="{{exportmd}}">
                <i class="fa fa-file-text-o" aria-hidden="true"></i>
            </a>
            <a href="{{pdfurl}}" class="local-quicknote-center__export" title="{{exportpdf}}" aria-label="{{exportpdf}}">
                <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
            </a>
            {{/hasnotes}}
        </div>
    </div>

    <div class="row" data-region="quicknote-results">
        {{#notes}}
        <div class="col-12 col-md-6 col-xl-4 mb-4">
            <div class="card h-100 shadow-sm" data-noteid="{{id}}">
                <div class="card-header local-quicknote-center__card-header">
                    <span class="local-quicknote-center__title" title="{{coursefullname}}">{{coursefullname}}</span>
                    {{#isglobal}}<span class="badge badge-info bg-info text-white">{{globalbadge}}</span>{{/isglobal}}
                </div>
                <div class="card-body">
                    {{#quote}}
                    <blockquote class="blockquote border-left border-primary pl-3 mb-3 local-quicknote-center__quote">
                        <p class="mb-1 font-italic text-muted local-quicknote-center__quote-text">{{quote}}</p>
                    </blockquote>
                    {{/quote}}
                    <div class="card-text local-quicknote-center__content">{{{contenthtml}}}</div>
                    {{#hastags}}
                    <div class="local-quicknote-center__tags" aria-label="{{#str}} tags, local_quicknote {{/str}}">
                        {{#tags}}<span class="badge badge-primary bg-primary text-bg-primary local-quicknote-center__tag">{{name}}</span>{{/tags}}
                    </div>
                    {{/hastags}}
                    {{#hasscreenshots}}
                    <div class="local-quicknote-center__screenshots">
                        {{#screenshots}}
                        <a href="{{url}}" target="_blank" rel="noopener">
                            <img src="{{url}}" alt="{{filename}}" loading="lazy">
                        </a>
                        {{/screenshots}}
                    </div>
                    {{/hasscreenshots}}
                </div>
                <div class="card-footer local-quicknote-center__card-footer text-muted small">
                    <span><i class="fa fa-clock-o mr-1" aria-hidden="true"></i>{{timeupdated}}</span>
                    <div class="local-quicknote-center__actionbar">
                        {{#actionurl}}
                        <a href="{{actionurl}}" target="_blank" rel="noopener" class="local-quicknote-center__card-action" title="{{#str}} note:viewintext, local_quicknote {{/str}}" aria-label="{{#str}} note:viewintext, local_quicknote {{/str}}">
                            <i class="fa fa-external-link" aria-hidden="true"></i>
                        </a>
                        {{/actionurl}}
                        <form method="post" action="{{config.wwwroot}}/local/quicknote/view.php" class="local-quicknote-center__delete-form" data-delete-confirm="{{deleteconfirm}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="deleteid" value="{{id}}">
                            <input type="hidden" name="coursefilter" value="{{coursefilter}}">
                            <input type="hidden" name="tagfilter" value="{{tagfilter}}">
                            <input type="hidden" name="searchterm" value="{{searchterm}}">
                            <input type="hidden" name="page" value="{{page}}">
                            <button type="submit" class="local-quicknote-center__card-action" title="{{#str}} note:delete, local_quicknote {{/str}}" aria-label="{{#str}} note:delete, local_quicknote {{/str}}">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {{/notes}}
        {{^notes}}
        <div class="col-12">
            <div class="alert alert-info">
                {{#hasnotestosearch}}
                    {{noresultstext}}
                {{/hasnotestosearch}}
                {{^hasnotestosearch}}
                    {{nonotesfound}}
                {{/hasnotestosearch}}
            </div>
        </div>
        {{/notes}}
    </div>

    <div data-region="quicknote-pagination">
        {{#pagingbar}}
        <div class="mt-4 mb-4 d-flex justify-content-center">
            {{{pagingbar}}}
        </div>
        {{/pagingbar}}
    </div>
</div>

{{#js}}
require(['local_quicknote/view'], function(view) {
    view.init();
});
{{/js}}
